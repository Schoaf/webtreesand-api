<?php

declare(strict_types=1);

use Api4Webtrees\Apps;
use Fisharebest\Webtrees\I18N;

/**
 * @var string                            $title
 * @var bool                              $logged_in
 * @var bool                              $secure
 * @var bool                              $home
 * @var list<array<string,mixed>>         $apps          aus src/Apps.php, fuer dieses Geraet sortiert (matches, open)
 * @var array<string,string>              $device_names  android => "Android-Handy und -Tablet" ...
 * @var array<string,array<string,string>> $badges       App-Kennung => Geraet => Bild des Store-Badges
 * @var array<string,string>              $download_qr   App-Kennung => QR-Code des Downloads (Handy-Apps)
 * @var string                            $connect_url
 * @var string                            $connect_qr
 * @var array<string,string>              $deep          App-Kennung => <schema>://connect?... (leer, wenn nicht angemeldet)
 * @var int                               $minutes
 * @var string                            $device        windows, linux, mac, android, ios, other
 * @var string                            $base_url
 */

$json = static fn (mixed $value): string => json_encode($value, JSON_THROW_ON_ERROR | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);

$devices = static fn (array $app): string => implode(', ', array_map(static fn (string $d): string => $device_names[$d] ?? $d, $app['devices']));

// Download-Knopf oder Store-Badge je Geraet, fuer das es die App gibt.
$downloads = static function (array $app) use ($badges): void {
    $several = count($app['download']) > 1;

    foreach ($app['download'] as $device => $url) {
        $badge = $badges[$app['id']][$device] ?? '';

        if ($badge !== '') {
            ?><a href="<?= e($url) ?>" class="me-2"><img src="<?= e($badge) ?>" alt="<?= e($app['name']) ?>" style="height: 3rem;"></a><?php
        } else {
            $label = !$several ? I18N::translate('App herunterladen') : ($device === 'ios' ? I18N::translate('Für iPhone/iPad') : ($device === 'android' ? I18N::translate('Für Android') : $device));
            ?><a class="btn btn-primary me-2 mb-1" href="<?= e($url) ?>"><?= e($label) ?></a><?php
        }
    }
};

$phone_first = in_array($device, ['android', 'ios', 'other'], true);

// Handy-App: installieren (Download + QR), dann per Tipp verbinden.
$phone = static function (array $app) use ($downloads, $download_qr, $logged_in, $secure, $home, $phone_first, $deep, $connect_qr, $minutes, $base_url): void {
    $name  = $app['name'];
    $link  = $deep[$app['id']] ?? '';
    $store = array_filter($app['download'], static fn (string $url): bool => str_contains($url, 'play.google.com') || str_contains($url, 'apps.apple.com')) !== [];
    ?>
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title h5"><?= I18N::translate('1. App installieren') ?></h3>
                    <p><?= $store
                        ? I18N::translate('Lade %s aus dem Store auf dein Handy oder Tablet.', $name)
                        : I18N::translate('Lade %s auf dein Android-Handy oder -Tablet. Beim ersten Mal fragt Android, ob dein Browser Apps installieren darf – das einmal erlauben.', $name) ?></p>
                    <p><?php $downloads($app) ?></p>
                    <?php if (($download_qr[$app['id']] ?? '') !== '') : ?>
                        <p class="text-muted small mb-1"><?= I18N::translate('Am Computer? Dann diesen Code mit der Handy-Kamera scannen:') ?></p>
                        <div style="max-width: 11rem; background: #fff; padding: .5rem;"><?= $download_qr[$app['id']] ?></div>
                    <?php endif ?>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title h5"><?= I18N::translate('2. Mit deinem Konto verbinden') ?></h3>
                    <?php if (!$logged_in) : ?>
                        <p><?= I18N::translate('Melde dich an, um die App mit deinem Konto zu verbinden.') ?></p>
                    <?php elseif ($app['scheme'] === '') : ?>
                        <?php /* Ohne Koppel-Schema: die App nimmt keinen Verbinden-Link an - Adresse, Benutzername und Passwort. */ ?>
                        <p><?= I18N::translate('In %s meldest du dich mit dieser Adresse, deinem webtrees-Benutzernamen und Passwort an:', $name) ?></p>
                        <p class="font-monospace"><?= e($base_url) ?></p>
                    <?php elseif (!$secure) : ?>
                        <p><?= I18N::translate('Das Verbinden per Code ist nur über eine verschlüsselte Verbindung (https) möglich. In der App kannst du dich stattdessen mit Adresse, Benutzername und Passwort anmelden.') ?></p>
                    <?php elseif ($phone_first) : ?>
                        <p><?= I18N::translate('Ein Tipp genügt – Adresse und Passwort musst du in der App nicht eintippen.') ?></p>
                        <p><a class="btn btn-primary" href="<?= e($link) ?>"><?= I18N::translate('Mit %s verbinden', $name) ?></a></p>
                        <?php if ($connect_qr !== '') : ?>
                            <p class="text-muted small mb-1"><?= I18N::translate('Am Computer? Dann diesen Code mit der Handy-Kamera scannen:') ?></p>
                            <div style="max-width: 13rem; background: #fff; padding: .5rem;"><?= $connect_qr ?></div>
                        <?php endif ?>
                    <?php else : ?>
                        <?php /* Am PC fuehrt der App-Link ins Leere (kein Programm nimmt das Schema an) - nur der QR-Code fuers Handy. */ ?>
                        <?php if ($connect_qr !== '') : ?>
                            <p><?= I18N::translate('Diesen Code mit der Handy-Kamera scannen – die App verbindet sich dann von selbst, ohne Adresse und Passwort.') ?></p>
                            <div style="max-width: 13rem; background: #fff; padding: .5rem;"><?= $connect_qr ?></div>
                        <?php else : ?>
                            <p><?= I18N::translate('Öffne diese Seite auf dem Handy und tippe dort auf „Mit %s verbinden“.', $name) ?></p>
                        <?php endif ?>
                        <?php if ($home) : ?>
                            <p class="text-muted small mt-2"><?= I18N::translate('Unverschlüsselt – nur im Heimnetz.') ?> <a href="https://github.com/thobgg/nas4webtrees#access-from-outside" target="_blank" rel="noopener"><?= I18N::translate('Von unterwegs erreichbar machen: Anleitung') ?></a></p>
                        <?php endif ?>
                        <p class="text-muted small mt-2"><?= I18N::translate('Der Code gilt %s Minuten und nur ein einziges Mal. Er verbindet die App mit deinem Konto – gib ihn nicht weiter.', I18N::number($minutes)) ?></p>
                    <?php endif ?>
                </div>
            </div>
        </div>
    </div>
    <?php
};

// Programm fuer den PC: herunterladen (neueste Datei aus dem GitHub-Release), dann verbinden. Der Knopf legt den
// Verbinden-Link in die Zwischenablage und oeffnet ihn; das Programm uebernimmt ihn von selbst - ohne Adresse,
// Benutzername und Passwort. "Adresse kopieren" bleibt als Rueckfall.
$pc = static function (array $app) use ($base_url, $secure, $home, $logged_in, $deep, $minutes): void {
    $name     = $app['name'];
    $os       = $app['devices'][0];
    $download = Apps::download($app, $os);
    // Liegt der Download in einem GitHub-Release, sucht die Seite beim Klick die neueste Datei per API (siehe Skript unten).
    $api      = preg_replace('#^https://github\.com/([^/]+/[^/]+)/releases/latest/?$#', 'https://api.github.com/repos/$1/releases/latest', $download);
    $api      = $api !== $download && $app['asset'] !== '' ? $api : '';
    $link     = $deep[$app['id']] ?? '';
    ?>
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title h5"><?= I18N::translate('1. Herunterladen und installieren') ?></h3>
                    <p><?= match ($os) {
                        'windows' => I18N::translate('%s ist das Programm für den Windows-PC.', $name),
                        'linux'   => I18N::translate('%s ist das Programm für den Linux-PC (Ubuntu, Debian, Mint).', $name),
                        default   => I18N::translate('%s ist das Programm für den Mac.', $name),
                    } ?></p>
                    <p><a class="btn btn-primary" data-api="<?= e($api) ?>" data-asset="<?= e($app['asset']) ?>" href="<?= e($download) ?>"><?= I18N::translate('%s herunterladen', $name) ?></a></p>
                    <?php if ($os === 'windows') : ?>
                        <p class="text-muted small"><?= I18N::translate('Die Datei doppelt anklicken. Warnt Windows („Der Computer wurde durch Windows geschützt“), auf „Weitere Informationen“ und dann „Trotzdem ausführen“ klicken.') ?></p>
                    <?php elseif ($os === 'linux') : ?>
                        <p class="text-muted small"><?= I18N::translate('Die .deb-Datei doppelt anklicken und installieren – oder im Terminal: sudo apt install ./Dateiname.deb') ?></p>
                    <?php elseif ($os === 'mac') : ?>
                        <p class="text-muted small"><?= I18N::translate('Die .dmg-Datei öffnen und %s in „Programme“ ziehen (arm64 für Macs mit Apple-Chip, x64 für Intel-Macs – beide auf der Release-Seite). Die Datei ist nicht signiert: beim ersten Start unter Systemeinstellungen › Datenschutz & Sicherheit „Trotzdem öffnen“. Testfassung – Rückmeldungen willkommen.', $name) ?></p>
                    <?php endif ?>
                    <p class="text-muted small mb-0"><?= I18N::translate('Schon installiert? Dann gleich weiter mit Schritt 2.') ?></p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title h5"><?= I18N::translate('2. Verbinden') ?></h3>
                    <?php if ($logged_in && $secure && $link !== '') : ?>
                        <p><?= I18N::translate('Ein Klick genügt – Adresse und Passwort musst du in %s nicht eintippen.', $name) ?></p>
                        <p><button type="button" class="btn btn-primary btn-lg" data-connect="<?= e($link) ?>"><?= I18N::translate('Mit %s verbinden', $name) ?></button></p>
                        <div class="alert alert-success d-none" data-connect-ok>
                            <?= I18N::translate('%1$s übernimmt die Verbindung jetzt von selbst und fragt einmal nach. Ist %1$s noch nicht geöffnet, starte es jetzt.', $name) ?>
                        </div>
                        <p class="small text-danger d-none" data-connect-fail><?= I18N::translate('Das hat nicht geklappt – bitte unten „Adresse kopieren“ nehmen und in %s mit Benutzername und Passwort anmelden.', $name) ?></p>
                        <p class="text-muted small"><?= I18N::translate('Der Code gilt %1$s Minuten und nur ein einziges Mal. Er verbindet %2$s mit deinem Konto – gib ihn nicht weiter.', I18N::number($minutes), $name) ?></p>
                        <hr>
                        <p class="small mb-1"><?= I18N::translate('Oder von Hand – die Adresse dieses Stammbaums:') ?></p>
                    <?php else : ?>
                        <?php if (!$logged_in) : ?>
                            <p><?= I18N::translate('Melde dich an – dann verbindet ein Klick %s mit deinem Konto.', $name) ?></p>
                        <?php endif ?>
                        <p class="mb-1"><?= I18N::translate('Die Adresse dieses Stammbaums:') ?></p>
                    <?php endif ?>
                    <div class="input-group mb-2">
                        <input type="text" class="form-control font-monospace" readonly value="<?= e($base_url) ?>" data-copy-source aria-label="<?= I18N::translate('Adresse') ?>">
                        <button type="button" class="btn btn-outline-primary" data-copy><?= I18N::translate('Adresse kopieren') ?></button>
                    </div>
                    <p class="small text-success d-none" data-copy-ok><?= I18N::translate('Kopiert.') ?></p>
                    <p class="small text-danger d-none" data-copy-fail><?= I18N::translate('Kopieren ging nicht – die Adresse ist markiert, bitte mit Strg+C kopieren.') ?></p>
                    <?php if ($secure) : ?>
                        <p class="small"><?= I18N::translate('Dann %s starten: Es übernimmt die kopierte Adresse von selbst (sonst mit Strg+V einfügen). Danach mit deinem webtrees-Benutzernamen und Passwort anmelden.', $name) ?></p>
                        <?php if ($home) : ?>
                            <p class="text-muted small"><?= I18N::translate('Unverschlüsselt – nur im Heimnetz.') ?> <a href="https://github.com/thobgg/nas4webtrees#access-from-outside" target="_blank" rel="noopener"><?= I18N::translate('Von unterwegs erreichbar machen: Anleitung') ?></a></p>
                        <?php endif ?>
                    <?php else : ?>
                        <p class="text-danger"><?= I18N::translate('Diese Adresse ist unverschlüsselt (http) und liegt nicht im Heimnetz – %s verbindet sich damit nicht. Bitte HTTPS einrichten.', $name) ?></p>
                    <?php endif ?>
                </div>
            </div>
        </div>
    </div>
    <?php
};

// Apple-Geraet ohne passende App (heute iPhone und iPad): ehrlich sagen, statt die Android-App zu zeigen.
$apple = in_array($device, ['mac', 'ios'], true) && array_filter($apps, static fn (array $app): bool => $app['matches']) === [];

?>

<h2 class="wt-page-title"><?= e($title) ?></h2>

<?php if ($apple) : ?>
    <div class="alert alert-info">
        <strong><?= I18N::translate('Für dieses Gerät gibt es noch kein eigenes Programm.') ?></strong><br>
        <?= I18N::translate('Nutze webtrees einfach hier im Browser – er funktioniert auf jedem Gerät. Hast du zusätzlich einen Computer oder ein Android-Handy, findest du die Programme darunter.') ?>
    </div>
<?php endif ?>

<?php foreach ($apps as $app) : ?>
    <?php if ($app['open']) : ?>
        <h3 class="h4 mt-4 mb-3"><?= e($devices($app)) ?>: <?= e($app['name']) ?></h3>
        <?php $app['kind'] === 'pc' ? $pc($app) : $phone($app) ?>
    <?php else : ?>
        <details class="mt-4">
            <summary class="h4"><?= I18N::translate('Auch für %1$s: %2$s', e($devices($app)), e($app['name'])) ?></summary>
            <div class="mt-3"><?php $app['kind'] === 'pc' ? $pc($app) : $phone($app) ?></div>
        </details>
    <?php endif ?>
<?php endforeach ?>

<script>
  (function () {
    // Download: die neueste Datei aus dem GitHub-Release suchen (Dateinamen tragen die Version). Erst beim Klick, damit
    // GitHub nur erfaehrt, wer wirklich herunterlaedt. Klappt es nicht, bleibt es bei der Release-Seite.
    document.querySelectorAll('a[data-api]').forEach(function (link) {
      var api = link.getAttribute('data-api');
      if (!api) { return; }
      link.addEventListener('click', function (event) {
        if (!window.fetch) { return; }
        event.preventDefault();
        var fallback = link.href;
        var pattern  = new RegExp(link.getAttribute('data-asset'), 'i');
        var timer    = new Promise(function (resolve, reject) { window.setTimeout(reject, 5000); });
        Promise.race([fetch(api, { headers: { Accept: 'application/vnd.github+json' } }), timer])
          .then(function (response) { if (!response.ok) { throw new Error(); } return response.json(); })
          .then(function (release) {
            var hit = (release.assets || []).filter(function (a) { return pattern.test(a.name); })[0];
            window.location.href = hit ? hit.browser_download_url : fallback;
          })
          .catch(function () { window.location.href = fallback; });
      });
    });

    // Text in die Zwischenablage: navigator.clipboard gibt es nur ueber https - im Heimnetz (http://) der alte Weg ueber
    // ein markiertes Textfeld. Muss direkt im Klick passieren, sonst verweigert der Browser das Kopieren.
    var copyText = function (text, done) {
      var legacy = function () {
        var area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        document.body.removeChild(area);
        done(ok);
      };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(function () { done(true); }, legacy);
      } else {
        legacy();
      }
    };

    // Der Einmal-Code gilt nur begrenzt. Wer erst herunterlaedt und installiert, kommt vielleicht spaeter zurueck -
    // dann die Seite neu laden (neuer Code), bevor jemand auf einen abgelaufenen Knopf klickt.
    var born   = Date.now();
    var maxAge = Math.max(60, <?= $json($minutes) ?> * 60 - 60) * 1000;
    var stale  = function () { return Date.now() - born > maxAge; };
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible' && stale() && document.querySelector('[data-connect]')) { window.location.reload(); }
    });

    // Mit dem PC-Programm verbinden: Link in die Zwischenablage (das Programm wartet darauf) und zusaetzlich oeffnen - in
    // einem unsichtbaren Rahmen, damit ein noch unbekanntes Schema keine Fehlerseite zeigt.
    document.querySelectorAll('button[data-connect]').forEach(function (button) {
      var box  = button.closest('.card-body');
      var ok   = box.querySelector('[data-connect-ok]');
      var fail = box.querySelector('[data-connect-fail]');
      button.addEventListener('click', function () {
        if (stale()) { window.location.reload(); return; }
        var link = button.getAttribute('data-connect');
        copyText(link, function (copied) {
          ok.classList.toggle('d-none', !copied);
          fail.classList.toggle('d-none', copied);
        });
        var frame = document.createElement('iframe');
        frame.style.display = 'none';
        frame.src = link;
        document.body.appendChild(frame);
        window.setTimeout(function () { document.body.removeChild(frame); }, 3000);
      });
    });

    // Adresse kopieren: wie oben; klappt es nicht, bleibt die Adresse zum Kopieren mit Strg+C markiert.
    document.querySelectorAll('button[data-copy]').forEach(function (button) {
      var box    = button.closest('.card-body');
      var input  = box.querySelector('[data-copy-source]');
      var ok     = box.querySelector('[data-copy-ok]');
      var fail   = box.querySelector('[data-copy-fail]');
      var show   = function (good) { ok.classList.toggle('d-none', !good); fail.classList.toggle('d-none', good); if (!good) { input.focus(); input.select(); } };
      input.addEventListener('focus', function () { input.select(); });
      button.addEventListener('click', function () { copyText(input.value, show); });
    });
  })();
</script>
