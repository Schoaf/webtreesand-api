    $asset = $os === 'windows' ? '\\.exe$' : '_amd64\\.deb$';
    ?>
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title h5"><?= I18N::translate('1. Herunterladen') ?></h3>
                    <p><?= $os === 'windows'
                        ? I18N::translate('%s ist das Programm für den Windows-PC.', $name)
                        : I18N::translate('%s ist das Programm für den Linux-PC (Ubuntu, Debian, Mint).', $name) ?></p>
                    <p><a class="btn btn-primary" data-asset="<?= e($asset) ?>" href="<?= e($download_url) ?>"><?= $os === 'windows' ? I18N::translate('%s für Windows herunterladen', $name) : I18N::translate('%s für Linux herunterladen', $name) ?></a></p>
                    <p class="text-muted small"><?= $os === 'windows'
                        ? I18N::translate('Die Datei doppelt anklicken. Warnt Windows („Der Computer wurde durch Windows geschützt“), auf „Weitere Informationen“ und dann „Trotzdem ausführen“ klicken.')
                        : I18N::translate('Die .deb-Datei doppelt anklicken und installieren – oder im Terminal: sudo apt install ./Dateiname.deb') ?></p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title h5"><?= I18N::translate('2. Verbinden') ?></h3>
                    <p class="mb-1"><?= I18N::translate('Die Adresse dieses Stammbaums:') ?></p>
                    <div class="input-group mb-2">
                        <input type="text" class="form-control form-control-lg font-monospace" readonly value="<?= e($base_url) ?>" data-copy-source aria-label="<?= I18N::translate('Adresse') ?>">
                        <button type="button" class="btn btn-primary" data-copy><?= I18N::translate('Adresse kopieren') ?></button>
                    </div>
                    <p class="small text-success d-none" data-copy-ok><?= I18N::translate('Kopiert.') ?></p>
                    <p class="small text-danger d-none" data-copy-fail><?= I18N::translate('Kopieren ging nicht – die Adresse ist markiert, bitte mit Strg+C kopieren.') ?></p>
                    <?php if ($secure) : ?>
                        <p><?= I18N::translate('Dann %s starten: Es übernimmt die kopierte Adresse von selbst (sonst mit Strg+V einfügen). Danach mit deinem webtrees-Benutzernamen und Passwort anmelden.', $name) ?></p>
                        <?php if ($home) : ?>
                            <p class="text-muted small"><?= I18N::translate('Unverschlüsselt – nur im Heimnetz. Für unterwegs: HTTPS einrichten.') ?></p>
                        <?php endif ?>
                    <?php else : ?>
                        <p class="text-danger"><?= I18N::translate('Diese Adresse ist unverschlüsselt (http) und liegt nicht im Heimnetz – %s verbindet sich damit nicht. Bitte HTTPS einrichten.', $name) ?></p>
                    <?php endif ?>
                </div>
            </div>
        </div>
    </div>
    <?php
};

$phone_first = !in_array($device, ['windows', 'linux'], true);
$others      = $phone_first ? ['windows', 'linux'] : ['phone', $device === 'windows' ? 'linux' : 'windows'];

?>

<h2 class="wt-page-title"><?= e($title) ?></h2>

<?php ob_start() ?>
<div class="row g-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="card-title h5"><?= I18N::translate('1. App installieren') ?></h3>
                <p><?= I18N::translate('Lade die App auf dein Android-Handy oder -Tablet. Beim ersten Mal fragt Android, ob dein Browser Apps installieren darf – das einmal erlauben.') ?></p>
                <p><a class="btn btn-primary" href="<?= e($download_url) ?>"><?= I18N::translate('App herunterladen') ?></a></p>
                <?php if ($download_qr !== '') : ?>
                    <p class="text-muted small mb-1"><?= I18N::translate('Am Computer? Dann diesen Code mit der Handy-Kamera scannen:') ?></p>
                    <div style="max-width: 11rem; background: #fff; padding: .5rem;"><?= $download_qr ?></div>
                <?php endif ?>

                <?php if ($app2 !== null && ($app2['android'] !== '' || $app2['ios'] !== '')) : ?>
