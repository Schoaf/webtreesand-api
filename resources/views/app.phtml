                    </p>
                    <?php if ($app2_qr !== '') : ?>
                        <div style="max-width: 11rem; background: #fff; padding: .5rem;"><?= $app2_qr ?></div>
                    <?php endif ?>
                <?php endif ?>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="card-title h5"><?= I18N::translate('2. Mit deinem Konto verbinden') ?></h3>
                <?php if (!$logged_in) : ?>
                    <p><?= I18N::translate('Melde dich an, um die App mit deinem Konto zu verbinden.') ?></p>
                <?php elseif (!$secure) : ?>
                    <p><?= I18N::translate('Das Verbinden per Code ist nur über eine verschlüsselte Verbindung (https) möglich. In der App kannst du dich stattdessen mit Adresse, Benutzername und Passwort anmelden.') ?></p>
                <?php else : ?>
                    <p><?= I18N::translate('Ein Tipp genügt – Adresse und Passwort musst du in der App nicht eintippen.') ?></p>
                    <p>
                        <a class="btn btn-primary" href="<?= e($deep_link) ?>"><?= $deep_link2 === '' ? I18N::translate('Jetzt verbinden') : I18N::translate('Mit wtAnd verbinden') ?></a>
                        <?php if ($deep_link2 !== '') : ?>
                            <a class="btn btn-outline-primary" href="<?= e($deep_link2) ?>"><?= I18N::translate('Mit %s verbinden', e($app2['name'] ?? '')) ?></a>
                        <?php endif ?>
                    </p>
                    <?php if ($connect_qr !== '') : ?>
                        <p class="text-muted small mb-1"><?= I18N::translate('Am Computer? Dann diesen Code mit der Handy-Kamera scannen:') ?></p>
                        <div style="max-width: 13rem; background: #fff; padding: .5rem;"><?= $connect_qr ?></div>
                    <?php endif ?>
                    <?php if ($home) : ?>
                        <p class="text-muted small mt-2"><?= I18N::translate('Unverschlüsselt – nur im Heimnetz. Für unterwegs: HTTPS einrichten.') ?></p>
                    <?php endif ?>
                    <p class="text-muted small mt-2"><?= I18N::translate('Der Code gilt %s Minuten und nur ein einziges Mal. Er verbindet die App mit deinem Konto – gib ihn nicht weiter.', I18N::number($minutes)) ?></p>
                <?php endif ?>
