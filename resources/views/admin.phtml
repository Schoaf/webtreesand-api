                            </div>
                        </td>
                        <td class="text-end">
                            <?php if ($tree['enabled']) : ?>
                                <a class="btn btn-sm btn-primary" href="<?= e($tree['app_url']) ?>" title="<?= I18N::translate('Seite „App“ öffnen') ?>"><?= I18N::translate('Verbinden') ?></a>
