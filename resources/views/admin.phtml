    <tr><th scope="row"><?= I18N::translate('Größte Datei beim Hochladen') ?></th><td><?= $max_upload > 0 ? I18N::number(round($max_upload / 1048576, 1), 1) . ' MB' : I18N::translate('unbekannt') ?></td></tr>
